# BetterCV Environment Configuration
# Copy this file to .env and update with your actual values
# This is a comprehensive example showing all available configuration options

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Option 1: Single connection string (recommended for production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bettercv

# Option 2: Individual connection parameters (alternative)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bettercv
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Legacy database variables (backward compatibility)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bettercv
DB_USER=postgres
DB_PASSWORD=postgres

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Node environment (development, production, test)
NODE_ENV=development

# Backend server port
PORT=3000

# Frontend URL (for CORS and links in emails)
FRONTEND_URL=http://localhost:3002

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================

# JWT secret key - MUST be changed in production!
# Generate with: openssl rand -hex 64
JWT_SECRET=your_very_long_random_secret_key_change_in_production

# JWT token expiration (examples: 7d, 24h, 60m)
JWT_EXPIRES_IN=7d

# BCrypt password hashing rounds (10-12 recommended)
BCRYPT_ROUNDS=12

# Session secret (if using sessions)
SESSION_SECRET=your_session_secret_here

# =============================================================================
# AI SERVICES
# =============================================================================

# Anthropic Claude API key (required for AI features)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Claude model to use (optional)
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# =============================================================================
# FILE UPLOADS
# =============================================================================

# Maximum file upload size in bytes (default: 10MB)
MAX_FILE_SIZE=10485760

# Upload directory path (relative to backend root)
UPLOAD_DIR=./uploads

# Allowed file types (comma-separated)
ALLOWED_FILE_TYPES=pdf,doc,docx,txt

# =============================================================================
# EMAIL/SMTP CONFIGURATION
# =============================================================================

# SMTP server configuration for sending emails
# Leave empty to disable email features

# SMTP host (e.g., smtp.gmail.com, smtp.sendgrid.net)
SMTP_HOST=smtp.gmail.com

# SMTP port (usually 587 for TLS, 465 for SSL, 25 for plain)
SMTP_PORT=587

# SMTP secure connection (true for port 465, false for 587)
SMTP_SECURE=false

# SMTP authentication
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# Email "from" address
SMTP_FROM=noreply@bettercv.com

# Legacy email variables (backward compatibility)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_FROM="BetterCV <noreply@bettercv.com>"

# =============================================================================
# REDIS CONFIGURATION (Optional)
# =============================================================================

# Redis connection (optional, for caching and sessions)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# =============================================================================
# RATE LIMITING
# =============================================================================

# General API rate limit window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per window per IP
RATE_LIMIT_MAX_REQUESTS=100

# Auth endpoint rate limit (stricter)
AUTH_RATE_LIMIT_MAX=5

# =============================================================================
# LOGGING
# =============================================================================

# Log level (error, warn, info, http, verbose, debug, silly)
LOG_LEVEL=info

# Log file path (optional)
LOG_FILE=./logs/app.log

# Debug namespaces (for debug module)
# DEBUG=app:*

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# Allowed CORS origins (comma-separated)
# In development, localhost ports are allowed by default
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002

# =============================================================================
# DEPLOYMENT & INFRASTRUCTURE
# =============================================================================

# GitLab Pages configuration (for website deployment)
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=your_gitlab_token_here
GITLAB_GROUP_ID=your_group_id_here

# Domain configuration
BASE_DOMAIN=bettercv.com
SUBDOMAIN_SUFFIX=.bettercv.com

# CDN URL (optional, for serving static assets)
CDN_URL=https://cdn.bettercv.com

# =============================================================================
# MONITORING & ANALYTICS (Optional)
# =============================================================================

# Sentry DSN for error tracking
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Google Analytics tracking ID
GA_TRACKING_ID=UA-XXXXXXXXX-X

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable/disable specific features
ENABLE_AI_FEATURES=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_2FA=false
ENABLE_ANALYTICS=false

# =============================================================================
# SECURITY HEADERS
# =============================================================================

# IP Whitelist (comma-separated IPs, leave empty to disable)
IP_WHITELIST=

# IP Blacklist (comma-separated IPs, leave empty to disable)
IP_BLACKLIST=

# =============================================================================
# DEVELOPMENT TOOLS
# =============================================================================

# pgAdmin credentials (for docker-compose.dev.yml)
PGADMIN_EMAIL=admin@bettercv.com
PGADMIN_PASSWORD=admin

# Mailhog configuration (development email testing)
MAILHOG_SMTP_HOST=localhost
MAILHOG_SMTP_PORT=1025

# =============================================================================
# TESTING
# =============================================================================

# Test database (optional, for running tests)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bettercv_test

# =============================================================================
# PRODUCTION CHECKLIST
# =============================================================================

# When deploying to production, ensure you:
# [ ] Change NODE_ENV to 'production'
# [ ] Generate a strong JWT_SECRET (64+ characters)
# [ ] Use a secure DATABASE_URL with strong password
# [ ] Configure SMTP for email functionality
# [ ] Set FRONTEND_URL to your actual domain
# [ ] Enable HTTPS/SSL
# [ ] Configure proper CORS_ORIGIN
# [ ] Set appropriate rate limits
# [ ] Enable monitoring (Sentry, etc.)
# [ ] Set up regular database backups
# [ ] Use environment-specific .env files
# [ ] Never commit .env files to version control
# [ ] Rotate secrets periodically
# [ ] Enable 2FA for admin accounts
# [ ] Review and update security headers
# [ ] Test all critical paths
# [ ] Set up CI/CD pipeline

# =============================================================================
# QUICK START
# =============================================================================

# For local development:
# 1. Copy this file to .env
# 2. Update ANTHROPIC_API_KEY with your key
# 3. Optionally configure SMTP for email testing
# 4. Run: docker-compose -f docker-compose.dev.yml up
# 5. Visit: http://localhost:3002 (dashboard)
# 6. API docs: http://localhost:3000/api-docs
