# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bettercv_db
DB_USER=bettercv_user
DB_PASSWORD=your_secure_password_here

# Server Configuration
PORT=3000
NODE_ENV=development

# Security
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random
JWT_EXPIRE=7d
BCRYPT_ROUNDS=12

# Claude AI Configuration
CLAUDE_API_KEY=your_claude_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Email Configuration (for verification and notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_email_password
EMAIL_FROM=noreply@bettercv.com

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,doc,docx,txt

# Domain Configuration
MAIN_DOMAIN=bettercv.com
SUBDOMAIN_PREFIX=
PROTOCOL=https

# GitLab Configuration
GITLAB_URL=https://gitlab.bettercv.com
GITLAB_TOKEN=your_gitlab_access_token
GITLAB_GROUP_ID=your_gitlab_group_id

# Loveable API (for template generation)
LOVEABLE_API_KEY=your_loveable_api_key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# 2FA Configuration
TWO_FA_SERVICE_NAME=BetterCV
TWO_FA_ISSUER=BetterCV System

# reCAPTCHA Configuration
RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key